rules_version = '2';

// Household "lock code" model: anyone who knows the 8-character code can
// read/write that household's data — like a shared lock code, not a
// per-person account. Anonymous Auth just keeps requests authenticated;
// the code itself is the access control.
//
// `list` (querying a collection rather than fetching one known document) is
// denied ONLY on the top-level `households` collection — without that, any
// anonymous client could enumerate every household code ever created
// instead of needing to already know one. This doesn't stop someone
// brute-forcing a single code directly, the same accepted limitation as a
// physical lock code.
//
// `list` is deliberately ALLOWED on everything nested under a specific
// `households/{code}` — a client can only reach that path if it already
// knows `code` (the outer deny blocks discovering codes by listing), and
// real-time sync (`onSnapshot` on a collection — list/todos/homeTasks/
// homeOneoff) is itself a `list` operation under the hood. The first version
// of these rules denied `list` here too, which silently broke every
// real-time listener while individual get/write kept working fine — sync
// looked "connected" (writes succeeded) but nothing ever arrived on the
// other device. Keep `list` allowed at this nested level.
//
// The weekly-digest Netlify function reads/writes via the Admin SDK, which
// bypasses these rules entirely (expected, documented in SETUP.md).
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{code} {
      allow get, write: if request.auth != null;
      allow list: if false;

      match /{collection}/{docId} {
        allow get, list, write: if request.auth != null;
      }
    }
  }
}
